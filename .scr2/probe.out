    rows= 333888
TABLE classification_failure
    CREATE TABLE classification_failure (             id INTEGER PRIMARY KEY AUTOINCREMENT,             signature TEXT,             slot INTEGER,             transaction_index INTEGER,             outer_index INTEGER,             inner_index INTEGER,             program_id TEXT,             discriminator TEXT,             reason TEXT NOT NULL,             context_json TEXT,             -- Machine-readable failure class. Written explicitly at every insert site so the             -- downstream coverage gate does not have to infer a class from prose. NULL means a row             -- written before thi
    rows= 0
