    rows= 4
TABLE program_version
    CREATE TABLE program_version (             program_id TEXT NOT NULL,             from_slot INTEGER NOT NULL,          -- inclusive             to_slot INTEGER NOT NULL,            -- inclusive             idl_path TEXT,                       -- NULL only for a KNOWN-UNCOVERED interval             idl_sha256 TEXT,             deploy_slot INTEGER,                 -- the deployment that opened this interval             evidence_key TEXT,                   -- -> raw_boundary_response.request_key             coverage TEXT NOT NULL CHECK(coverage IN ('covered','uncovered')),             PRIMARY KEY(
    rows= 2
TABLE instruction
