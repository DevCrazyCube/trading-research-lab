{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "next_agent", "user_question"],
  "properties": {
    "status": {"enum": ["handoff", "user_required", "blocked", "complete"]},
    "summary": {"type": "string", "minLength": 1},
    "next_agent": {"enum": ["codex", "claude", "none"]},
    "user_question": {"type": "string"}
  }
}
