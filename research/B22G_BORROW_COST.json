{
 "document": "B22G_BORROW_COST",
 "created": "2026-08-16",
 "question": "What does it cost to borrow the names this programme would actually short, and can it be sourced repeatably?",
 "why": "The T2 cost model carried borrow_annual = 0.003 (30 bp/yr) with a BROKER_SCHEDULE provenance whose own source string warned that hard-to-borrow names are not that. The ORB universe is the day's most-active names, which is exactly the population where that warning bites. This measures it instead of inheriting it.",
 "universe": {
  "what": "the 100-symbol ORB most-actives pool used by the B22B slippage run",
  "path": "/home/anont/.claude/jobs/5d56bbe0/tmp/orb_universe.json",
  "n": 100
 },
 "sources": [
  {
   "id": "alpaca_assets",
   "what": "GET /v2/assets/{symbol} on the account this programme would trade in",
   "gives": "shortable, easy_to_borrow, borrow_status, margin_requirement_short",
   "does_not_give": "a RATE. It is a status flag. Reading easy_to_borrow as 'free' is the zero-where-a-measurement-is-missing error this programme keeps dying of.",
   "coverage": "100/100 symbols -- complete",
   "fetched": "2026-08-16"
  },
  {
   "id": "alpaca_fee_schedule",
   "what": "Alpaca's published short-selling fee schedule",
   "gives": "$0 locate and borrow fee on ETB shares for Trading API users; HTB charged as sum(HTB short market value * that stock's HTB rate) / 360 per day",
   "rate_source": "GET /v1/locates/quotes on the LIVE trading host",
   "status_here": "endpoint exists on api.alpaca.markets but returns 403 for this key (no live/HTB entitlement); 404 on paper-api. Rates NOT obtainable by us.",
   "url": "https://docs.alpaca.markets/us/docs/margin-and-short-selling"
  },
  {
   "id": "ibkr_via_chartexchange",
   "what": "Interactive Brokers' shortable-securities feed (usa.txt, republished 15-minutely)",
   "gives": "indicative cost to borrow, percent per year, plus shares available",
   "why_republished": "ftp3.interactivebrokers.com and ftp.interactivebrokers.com are both unreachable from this host (connect timeout); the republication was used instead and is labelled as second-hand.",
   "coverage": "25/100 symbols",
   "why_partial": "ChartExchange bot-blocked the host after ~22 symbol pages ('Please verify you are not a robot') and the block did not lift on retry. The uncovered symbols are UNKNOWN, not zero, and are listed below.",
   "fetched": "2026-08-16"
  },
  {
   "id": "davolio_2002",
   "what": "D'Avolio, The Market for Borrowing Stock, JFE 66 (2002) 271-306",
   "gives": "91% of borrowed stock is general collateral at ~17 bp/yr mean; the other ~9% are loan-market specials averaging 4.30%/yr",
   "role": "an independent order-of-magnitude check on the measured split, not a substitute for it -- the sample is 2000-2001 institutional data, not 2026 retail."
  }
