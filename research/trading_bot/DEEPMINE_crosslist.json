  "what": "identical to B1 but entered at the SAME close that generated the signal",
  "design_gross_sharpe": 2.336,
  "design_gross_t": 5.6,
  "lag2_twin_B1_design_gross_sharpe": -0.37,
  "reading": "A same-close entry manufactures a bar-clearing gross Sharpe of 2.34 out of a series whose lag-2-entry twin scores -0.37. This is the single most dangerous artefact in the sub-family and it is what an unguarded ADR RV backtest would have reported as a discovery. Even so its NET is -88 bp."
 },
 "measurement_noise_diagnostic": {
  "statistic": "lag-1 autocorrelation of the daily change in the log cross-listing spread",
