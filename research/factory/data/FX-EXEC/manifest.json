  "rates_unit": "decimal per year (0.05 = 5 %); every currency: last observation dated strictly before the print date; USD: one EXTRA business day (see usd_rate_asymmetry)",
  "carry_convention": "(i_fx - i_usd) * days / 360 with i_usd = effective fed funds of the last calendar day before the print (accrual, NOT the USD column of aux['rates']); days = calendar days since the previous print; first row NaN",
  "cpi_convention": "index level; a monthly observation is usable from the 1st day of the 2nd month after its reference month starts, a quarterly one (AUD, NZD) from the 1st day of the 4th month after its reference quarter starts; step function until the next release; current-vintage data (NOT real-time vintages)",
  "oil_convention": "WTI spot price level (USD/bbl), FRED DCOILWTICO, last observation dated strictly before the print; non-positive observations (one: -36.98 on 2020-04-20) are set to NaN before the <= 3-print forward-fill, so every value in aux['oil'] is > 0",
  "universe_mask_note": "True where the price AND the carry of the instrument are known at the row (an instrument without a financing leg may not be held: the engine refuses it)",
  "first_row_all_groups_complete": "1999-01-05 13:15:00+00:00",
  "last_row_all_groups_complete": "2026-11-06 13:15:00+00:00",
  "usd_rate_asymmetry": "aux['rates']['USD'] = effective fed funds of the Federal Reserve business day two before the print date (already published at 14:15 Europe/Berlin). carry and tbill are NOT built from it: they accrue the rate of the last calendar day before the print. Hence carry[c] = aux['rates'][c] * days/360 - tbill, and carry[c] != (rates[c] - rates['USD']) * days/360.",
  "print_convention": "Decision print = ECB reference rate of the row's date (fixed around 14:10 CET, published around 16:00 CET the same day per the conductor note of 2026-11-10); row timestamp = 14:15 Europe/Berlin -> UTC, the conservative decision instant (USD per 1 FX, crossed through the euro). Rows = dates present in BOTH the ECB series and the FRED H.10 series. aux['exec_prices'] = the FRED H.10 noon buying rate in New York of the SAME date (12:00 America/New_York = 17:00 or 18:00 Berlin time, i.e. after the 14:15 fixing and after the ~16:00 CET publication), converted to USD per 1 FX; never forward-filled.",
  "exec_prices_strictly_after_decision": true,
  "exec_print_clock": "12:00 America/New_York on the row's date",
  "exec_minus_decision_hours": {
   "min": 2.75,
   "max": 4.75
  },
  "carry_alignment": "sum of the ECB-calendar accruals (i_fx - i_usd) * days / 360 over the ECB prints in (previous row, row]; decision and execution intervals span the same dates",
